{
  "description": "claude-guardrails' secret scanners, wired as its installer does: block a prompt with a secret, and a git commit whose staged diff has one (exit 2).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/scan-secrets.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/scan-commit.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
