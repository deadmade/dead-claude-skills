{
  "description": "Prose check after every Markdown write or edit: prose-check.mjs flags conversation shorthand and undefined abbreviations in the new text. FLOWS_PROSE_CHECK=off turns it off.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/prose-check.mjs"]
          },
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/prose-check.mjs"]
          }
        ]
      }
    ]
  }
}
