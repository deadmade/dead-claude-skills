{
  "name": "dead-claude-skills",
  "version": "0.5.0",
  "private": true,
  "description": "Interactive installer for the dead-claude-skills Claude Code marketplace.",
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "test": "node scripts/check-repo.mjs && node --test \"installer/**/*.test.ts\" \"scripts/*.test.mjs\" \"plugins/default/hooks/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc"
  },
  "bin": {
    "dead-claude-skills": "installer/install.js"
  },
  "files": [
    "installer/**/*.js",
    "!installer/**/*.test.js",
    "installer/assets/",
    ".claude-plugin/marketplace.json",
    "plugins/*/.claude-plugin/plugin.json",
    "plugins/*/*/.claude-plugin/plugin.json",
    "plugins/*/*/*/.claude-plugin/plugin.json"
  ],
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
