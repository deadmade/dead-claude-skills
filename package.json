{
  "name": "dead-claude-skills",
  "version": "0.6.0",
  "private": true,
  "description": "Interactive installer for the dead-claude-skills Claude Code marketplace.",
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "test": "node scripts/check-repo.mjs && node --test --experimental-test-coverage --test-coverage-include=\"installer/**\" --test-coverage-exclude=\"installer/**/*.test.ts\" --test-coverage-lines=79 \"installer/**/*.test.ts\" && node --test \"scripts/*.test.mjs\" \"plugins/default/hooks/*.test.mjs\" \"plugins/flows/hooks/*.test.mjs\" \"plugins/opt-in/headroom-trim/hooks/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "scan-skills": "pipx run --spec cisco-ai-skill-scanner==2.3.2 skill-scanner scan-all plugins --recursive --policy .github/skill-scanner.yaml --fail-on-severity high",
    "prepack": "tsc"
  },
  "bin": {
    "dead-claude-skills": "installer/install.js"
  },
  "files": [
    "installer/**/*.js",
    "!installer/**/*.test.js",
    "installer/assets/",
    ".claude-plugin/marketplace.json",
    "plugins/*/.claude-plugin/plugin.json",
    "plugins/*/*/.claude-plugin/plugin.json",
    "plugins/*/*/*/.claude-plugin/plugin.json"
  ],
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
