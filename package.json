{
  "name": "dead-claude-skills",
  "version": "0.2.0",
  "private": true,
  "description": "Interactive installer for the dead-claude-skills Claude Code marketplace.",
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "test": "node scripts/check-repo.mjs && node --test \"installer/*.test.mjs\" \"scripts/*.test.mjs\""
  },
  "bin": {
    "dead-claude-skills": "installer/install.mjs"
  },
  "files": [
    "installer/",
    ".claude-plugin/marketplace.json",
    "plugins/*/.claude-plugin/plugin.json",
    "plugins/*/*/.claude-plugin/plugin.json"
  ],
  "engines": {
    "node": ">=20.12"
  }
}
