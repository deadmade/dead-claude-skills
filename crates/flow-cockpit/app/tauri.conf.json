{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flow-cockpit",
  "identifier": "dev.deadmade.flow-cockpit",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flow cockpit",
        "width": 1280,
        "height": 860,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
